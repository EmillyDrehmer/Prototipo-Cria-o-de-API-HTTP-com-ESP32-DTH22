
#include <WiFi.h>
#include <WebServer.h>
#include <DHT.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// ===== CONFIGURACOES DO WI-FI =====
const char* ssid = "TesteESP32";
const char* password = "senha1234";

// ===== CONFIGURACOES DO DHT11 =====
#define DHT_PIN 15
#define DHT_TYPE DHT11

DHT dht(DHT_PIN, DHT_TYPE);

// ===== CONFIGURACOES DO OLED =====
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_ADDRESS 0x3C

// Pinos I2C confirmados no teste
#define OLED_SDA 21
#define OLED_SCL 22

Adafruit_SSD1306 display(
  SCREEN_WIDTH,
  SCREEN_HEIGHT,
  &Wire,
  -1
);

bool oledDisponivel = false;

// ===== SERVIDOR HTTP =====
WebServer server(80);
bool servidorIniciado = false;

// ===== DADOS DO SENSOR =====
float temperatura = 0;
float umidade = 0;
bool leituraValida = false;

unsigned long ultimaLeitura = 0;
const unsigned long INTERVALO_LEITURA = 2000;

// ===== CONTROLE DO WI-FI =====
bool wifiTentando = false;
unsigned long inicioTentativaWiFi = 0;
unsigned long proximaTentativaWiFi = 0;

const unsigned long TEMPO_LIMITE_WIFI = 10000;
const unsigned long INTERVALO_RECONEXAO = 15000;

// ===== ATUALIZAR OLED =====
void atualizarDisplay() {
  if (!oledDisponivel) {
    return;
  }

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);

  display.setTextSize(1);
  display.setCursor(15, 0);
  display.println("SENSOR DHT11");

  display.setCursor(0, 13);

  if (WiFi.status() == WL_CONNECTED) {
    display.println("Wi-Fi: conectado");
  } else {
    display.println("Wi-Fi: desconectado");
  }

  display.drawLine(0, 24, 127, 24, SSD1306_WHITE);

  if (leituraValida) {
    display.setTextSize(1);
    display.setCursor(0, 29);
    display.println("Temperatura:");

    display.setTextSize(2);
    display.setCursor(0, 39);
    display.print(temperatura, 1);
    display.print(" C");

    display.setTextSize(1);
    display.setCursor(0, 56);
    display.print("Umidade: ");
    display.print(umidade, 1);
    display.print("%");
  } else {
    display.setTextSize(1);
    display.setCursor(0, 36);
    display.println("Erro na leitura");
    display.setCursor(0, 48);
    display.println("do DHT11!");
  }

  display.display();
}

// ===== LER SENSOR =====
void lerSensor() {
  float novaTemperatura = dht.readTemperature();
  float novaUmidade = dht.readHumidity();

  if (isnan(novaTemperatura) || isnan(novaUmidade)) {
    leituraValida = false;

    Serial.println("ERRO: Falha na leitura do DHT11!");

    atualizarDisplay();
    return;
  }

  temperatura = novaTemperatura;
  umidade = novaUmidade;
  leituraValida = true;

  Serial.print("Temperatura: ");
  Serial.print(temperatura, 1);
  Serial.println(" C");

  Serial.print("Umidade: ");
  Serial.print(umidade, 1);
  Serial.println(" %");

  Serial.println("--------------------");

  atualizarDisplay();
}

// ===== ENDPOINT DA API =====
void handleDados() {
  if (!leituraValida) {
    server.send(
      500,
      "application/json",
      "{\"erro\":\"Falha na leitura do DHT11\"}"
    );
    return;
  }

  String json = "{";
  json += "\"temperatura\":";
  json += String(temperatura, 1);
  json += ",\"umidade\":";
  json += String(umidade, 1);
  json += "}";

  server.send(200, "application/json", json);
}

// ===== PAGINA INICIAL =====
void handleRaiz() {
  server.send(
    200,
    "text/plain",
    "ESP32 DHT11 API funcionando! Acesse /api/dados"
  );
}

// ===== INICIAR CONEXAO WI-FI =====
void iniciarConexaoWiFi() {
  Serial.print("Iniciando conexao Wi-Fi: ");
  Serial.println(ssid);

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  wifiTentando = true;
  inicioTentativaWiFi = millis();
}

// ===== GERENCIAR WI-FI =====
void gerenciarWiFi() {
  unsigned long agora = millis();

  if (WiFi.status() == WL_CONNECTED) {
    wifiTentando = false;

    if (!servidorIniciado) {
      Serial.println();
      Serial.println("Wi-Fi conectado!");

      Serial.print("IP do ESP32: ");
      Serial.println(WiFi.localIP());

      server.begin();
      servidorIniciado = true;

      Serial.println("Servidor HTTP iniciado!");

      Serial.print("API: http://");
      Serial.print(WiFi.localIP());
      Serial.println("/api/dados");

      atualizarDisplay();
    }

    return;
  }

  if (wifiTentando) {
    if (agora - inicioTentativaWiFi >= TEMPO_LIMITE_WIFI) {
      Serial.println();
      Serial.println("ERRO: Nao foi possivel conectar ao Wi-Fi.");
      Serial.println("Verifique nome, senha e compatibilidade da rede.");

      WiFi.disconnect();
      wifiTentando = false;
      proximaTentativaWiFi = agora + INTERVALO_RECONEXAO;

      atualizarDisplay();
    }

    return;
  }

  if (agora >= proximaTentativaWiFi) {
    Serial.println("Tentando reconectar ao Wi-Fi...");
    iniciarConexaoWiFi();
  }
}

// ===== SETUP =====
void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println();
  Serial.println("Iniciando sistema ESP32...");

  // Inicializacao explicita do I2C
  Wire.begin(OLED_SDA, OLED_SCL);

  if (display.begin(
        SSD1306_SWITCHCAPVCC,
        OLED_ADDRESS
      )) {
    oledDisponivel = true;

    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);
    display.setTextSize(2);
    display.setCursor(0, 10);
    display.println("OLED OK");

    display.setTextSize(1);
    display.setCursor(0, 40);
    display.println("Iniciando sistema...");
    display.display();

    Serial.println("OLED inicializado!");
    delay(1000);
  } else {
    Serial.println("ERRO: Falha ao iniciar o OLED.");
  }

  dht.begin();
  Serial.println("DHT11 inicializado!");

  // Registrar rotas da API
  server.on("/api/dados", HTTP_GET, handleDados);
  server.on("/", HTTP_GET, handleRaiz);

  // Primeira leitura do sensor
  lerSensor();
  ultimaLeitura = millis();

  // Iniciar tentativa de conexao sem espera infinita
  iniciarConexaoWiFi();

  Serial.println("Inicializacao concluida.");
}

// ===== LOOP PRINCIPAL =====
void loop() {
  gerenciarWiFi();

  if (servidorIniciado && WiFi.status() == WL_CONNECTED) {
    server.handleClient();
  }

  unsigned long agora = millis();

  if (agora - ultimaLeitura >= INTERVALO_LEITURA) {
    ultimaLeitura = agora;
    lerSensor();
  }
}